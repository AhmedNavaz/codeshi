# Copy this file to .env next to compose.yaml, fill in both values and keep it
# private: chmod 600 .env

# The service's public hostname. Point its DNS record at this server first, so
# Caddy can get a certificate for it.
SHARING_DOMAIN=share.example.com

# Required to create links. Generate a strong key with: openssl rand -hex 32
# Give the same key to Codeshi as AI_RELAY_SHARING_CREATE_KEY (see sharing/README.md).
SHARING_CREATE_KEY=
