{
  "rules": {
    ".read": false,
    ".write": false,
    "owners": {
      "$owner": {
        ".read": "auth != null && auth.uid === $owner",
        ".write": "auth != null && auth.uid === $owner",
        "$room": { ".validate": "$room.matches(/^[a-f0-9]{64}$/) && newData.val() === true" }
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null && data.child('meta/owner').val() === auth.uid",
        ".write": "auth != null && (data.child('meta/owner').val() === auth.uid || (!data.exists() && newData.child('meta/owner').val() === auth.uid))",
        ".validate": "$room.matches(/^[a-f0-9]{64}$/) && newData.hasChild('meta')",
        "meta": {
          ".read": "auth != null",
          ".validate": "newData.hasChildren(['owner', 'state', 'peer', 'expiresAt'])",
          "owner": { ".validate": "newData.isString() && newData.val() === auth.uid && (!data.exists() || data.val() === newData.val())" },
          "state": { ".validate": "newData.val() === 'waiting' || newData.val() === 'pending' || newData.val() === 'active'" },
          "peer": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "expiresAt": { ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 604800000" },
          "$other": { ".validate": false }
        },
        "request": {
          ".write": "auth != null && data.parent().child('meta/expiresAt').val() > now && newData.child('uid').val() === auth.uid && (data.parent().child('meta/state').val() === 'waiting' || (data.parent().child('meta/peer').val() === auth.uid && (data.parent().child('meta/state').val() === 'pending' || data.parent().child('meta/state').val() === 'active')))",
          ".validate": "newData.hasChildren(['uid', 'box'])",
          "uid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "box": {
            ".validate": "newData.hasChildren(['iv', 'data'])",
            "iv": { ".validate": "newData.isString() && newData.val().length === 16" },
            "data": { ".validate": "newData.isString() && newData.val().length <= 1398124" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },
        "out": {
          ".read": "auth != null && data.parent().child('meta/peer').val() === auth.uid && data.parent().child('meta/expiresAt').val() > now",
          ".validate": "newData.hasChildren(['iv', 'data'])",
          "iv": { ".validate": "newData.isString() && newData.val().length === 16" },
          "data": { ".validate": "newData.isString() && newData.val().length <= 1398124" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
