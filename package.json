{
  "name": "codeshi",
  "version": "0.41.0",
  "description": "Claude Code, Codex, Gemini and local models in one conversation. Switch agents mid-task, keep going when one hits its limit, and use the plans you already pay for.",
  "keywords": [
    "claude-code",
    "codex",
    "gemini",
    "gemini-cli",
    "ollama",
    "ai",
    "agentic-ai",
    "multi-agent",
    "agent-orchestration",
    "coding-agent",
    "desktop",
    "electron"
  ],
  "homepage": "https://github.com/AhmedNavaz/codeshi#readme",
  "bugs": {
    "url": "https://github.com/AhmedNavaz/codeshi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhmedNavaz/codeshi.git"
  },
  "license": "MIT",
  "author": "Ahmed Nawaz",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "main": "desktop/main.mjs",
  "productName": "Codeshi",
  "scripts": {
    "start": "node desktop/launch.mjs",
    "start:fresh": "node desktop/launch.mjs --fresh",
    "start:update-demo": "node desktop/launch.mjs --update-demo",
    "desktop": "node desktop/launch.mjs",
    "web": "node src/server.mjs",
    "test": "node --import ./test/isolate.mjs --test test/*.test.mjs sharing/test/*.test.mjs",
    "test:desktop": "node desktop/launch.mjs --smoke-test",
    "sharing": "node sharing/server.mjs",
    "eval": "node evals/cli.mjs",
    "stats": "node scripts/stats.mjs",
    "package": "node desktop/package.mjs",
    "icons": "electron desktop/icons.mjs",
    "i18n": "node scripts/i18n.mjs",
    "build:phone": "node scripts/build-phone.mjs",
    "measure:phone": "node scripts/measure-phone.mjs",
    "test:phone:remote": "firebase emulators:exec --only auth,database --project demo-codeshi-phone --config remote/firebase.json \"node --test remote/test/relay.test.mjs\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.302",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.9.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0"
  },
  "overrides": {
    "@electron/asar": {
      "glob": "14.0.2",
      "minimatch": "11.0.1"
    }
  }
}
